PORT=4400
NODE_ENV=production

# Timezone. The application and the database both work in this zone, whatever the
# server's own clock is set to. TZ takes an IANA name; DB_TIME_ZONE takes the
# matching UTC offset, because MySQL needs its timezone tables loaded to accept a name.
TZ=Asia/Colombo
DB_TIME_ZONE=+05:30

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=gkuc
DB_PASSWORD=
DB_NAME=gkuc_siteops
DB_POOL_SIZE=10

# Object storage. "local" writes into the uploads/ folder at the repository root.
# Switch to "r2" once the Cloudflare bucket exists — no code changes are needed.
STORAGE_DRIVER=local
UPLOAD_DIR=

# Largest file accepted, in MB. Set to 0 for no limit.
# Uploads stream to disk rather than being held in memory, so a large file costs disk
# and time rather than the server's memory. Keep the proxy's client_max_body_size above
# this figure so the application is the one refusing, with the clearer message.
MAX_UPLOAD_MB=0

# Scratch space for half-received uploads and OCR page renders.
# Defaults to a .tmp folder inside UPLOAD_DIR, which matters: on many Ubuntu servers
# /tmp is a RAM-backed tmpfs, and writing large uploads there would put them straight
# back into memory. Point this at real disk with plenty of room.
UPLOAD_TMP_DIR=

# ---------------------------------------------------------------------------
# Reading text out of documents (OCR)
#
# Needs two programs on the server, not npm packages:
#     apt install -y tesseract-ocr poppler-utils
#
# Everything is read on this machine; no document is sent to a third party.
# PDFs that already contain text are read directly and exactly; only true scans
# and photographs go through character recognition.
#
# For Sinhala and Tamil, install the language data and list them here:
#     apt install -y tesseract-ocr-sin tesseract-ocr-tam
#     OCR_LANGUAGES=eng+sin+tam
# ---------------------------------------------------------------------------
OCR_LANGUAGES=eng
OCR_MAX_PAGES=100
OCR_PAGE_TIMEOUT_MS=120000
OCR_POLL_MS=5000

# Cloudflare R2 (only read when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Alerting
ALERT_INTERVAL_MINUTES=60
ALERT_WINDOW_DAYS=30
ATTENDANCE_LATE_AFTER=08:00:00

# Notification channels. Comma-separated: WhatsApp,SMS,Email. Empty keeps alerts in-app.
# Add WhatsApp here once the credentials below are filled in, or automatic alerts stay
# on screen only. The composer sends regardless of this setting — somebody who picked
# recipients and pressed send has already decided.
NOTIFY_CHANNELS=
NOTIFY_MIN_SEVERITY=Warning
NOTIFY_EMAIL_FROM=siteops@gkuc.lk
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# ---------------------------------------------------------------------------
# WhatsApp — supplied by the client. PLACEHOLDERS: replace before go-live.
#
# From Meta: Business account -> WhatsApp -> API Setup. WHATSAPP_PHONE_ID is the
# "Phone number ID" shown there, not the phone number itself. The token must be a
# permanent System User token; the 24-hour test token expires overnight and every
# message then records as Failed.
#
# WHATSAPP_API_BASE only needs setting if messages go through a solution provider
# rather than Meta directly, or to point at a sandbox for testing.
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# Numbers are stored the way people write them here ("077 4412210"). This is the
# country code they are sent with, after the leading 0 is dropped.
DEFAULT_COUNTRY_CODE=94

# Password given to the seeded review accounts on first start
SEED_PASSWORD=GKUC@2026
