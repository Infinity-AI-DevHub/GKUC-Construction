PORT=4173
NODE_ENV=production

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=gkuc
DB_PASSWORD=
DB_NAME=gkuc_siteops
DB_POOL_SIZE=10

# Object storage. "local" writes into the uploads/ folder at the repository root.
# Switch to "r2" once the Cloudflare bucket exists — no code changes are needed.
STORAGE_DRIVER=local
UPLOAD_DIR=
MAX_UPLOAD_MB=15

# Cloudflare R2 (only read when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Alerting
ALERT_INTERVAL_MINUTES=60
ALERT_WINDOW_DAYS=30
ATTENDANCE_LATE_AFTER=08:00:00

# Notification channels. Comma-separated: WhatsApp,SMS,Email. Empty keeps alerts in-app.
NOTIFY_CHANNELS=
NOTIFY_MIN_SEVERITY=Warning
NOTIFY_EMAIL_FROM=siteops@gkuc.lk
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Password given to the seeded review accounts on first start
SEED_PASSWORD=GKUC@2026
