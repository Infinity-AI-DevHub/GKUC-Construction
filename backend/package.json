{
  "name": "@gkuc/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "storage:migrate:r2": "node src/scripts/migrate-local-uploads-to-r2.js",
    "storage:migrate:r2:apply": "node src/scripts/migrate-local-uploads-to-r2.js --apply",
    "storage:diagnose:r2": "node src/scripts/diagnose-r2.js",
    "access:suspend": "node src/scripts/set-service-access.js suspend",
    "access:restore": "node src/scripts/set-service-access.js restore",
    "payroll:migrate-ot": "node src/scripts/migrate-employee-ot-rates.js",
    "test": "node --test",
    "storage:migrate:s3": "node src/scripts/migrate-local-uploads-to-r2.js",
    "storage:migrate:s3:apply": "node src/scripts/migrate-local-uploads-to-r2.js --apply",
