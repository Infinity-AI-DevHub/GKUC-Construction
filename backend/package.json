    "payroll:diagnose": "node src/scripts/diagnose-payroll.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "helmet": "8.0.0",
    "mysql2": "3.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "3.24.2"
